# Copy with `make env`, then edit .env locally. Never commit credentials.
# Process environment (including Aiven Runtime secrets) overrides this file.
# This backend currently serves one shared, mocked workspace; it has no login.
GRIDCRAFT_BIND=127.0.0.1
PORT=8080
GRIDCRAFT_STATIC_DIR=dist/web
GRIDCRAFT_WORKSPACE_ID=00000000-0000-4000-8000-000000000001
GRIDCRAFT_MIGRATE_ON_START=false

# Existing Aiven PostgreSQL connection URI, injected as DATABASE_URL on Runtime.
# Leave empty to run the offline UI and liveness/status endpoints without storage.
DATABASE_URL=
DATABASE_SSL_MODE=verify-full
# Choose one CA source: local path, multiline PEM, OR base64 of the entire PEM file.
DATABASE_SSL_ROOT_CERT=
DATABASE_SSL_ROOT_CERT_PEM=
DATABASE_SSL_ROOT_CERT_BASE64=
# For an isolated local PostgreSQL only: DATABASE_SSL_MODE=disable (loopback only).

# Provider adapters are implemented; the UI/durable agent loop is not connected yet.
# Use a model enabled in your OpenAI account. No provider is called at startup.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
# Optional. Some reasoning models (e.g. gpt-6-luna) accept function tools on
# chat completions only with reasoning_effort=none.
OPENAI_REASONING_EFFORT=
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=
